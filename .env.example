# =================================================
# SaaS Turnos - Variables de entorno
# Copiar este archivo a .env y completar los valores
# NUNCA commitear .env con valores reales
# =================================================

# ---- Base de datos ----
DB_URL=jdbc:postgresql://localhost:5432/turnos_db
DB_USER=postgres
DB_PASSWORD=changeme

# ---- JWT ----
# Mínimo 32 caracteres aleatorios
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres-aleatorios

# ---- Gmail (notificaciones email) ----
GMAIL_USER=notificaciones@empresa.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- Server (opcional) ----
SERVER_PORT=8080
